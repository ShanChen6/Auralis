# --- Docker Compose (PostgreSQL + Redis local) ---
POSTGRES_USER=auralis
POSTGRES_PASSWORD=auralis
POSTGRES_DB=auralis
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- auralis-api (NestJS) ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://auralis:auralis@localhost:5432/auralis?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=
API_PUBLIC_URL=http://localhost:4000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=auralis-media
R2_PUBLIC_URL=https://cdn.example.com
R2_PRESIGN_EXPIRES_IN=600

# --- On-Demand ISR (dùng chung giữa auralis-api và auralis-web) ---
REVALIDATE_SECRET=
WEB_URL=http://localhost:3000
POST_DAILY_LIMIT=5

# --- auralis-web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- auralis-audio-ai (FastAPI) ---
AUDIO_AI_URL=http://localhost:8000
# Dùng chung giữa auralis-api và auralis-audio-ai để gọi /api/v1/generate-radio
AUDIO_AI_API_KEY=
