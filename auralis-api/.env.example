DATABASE_URL="postgresql://auralis:auralis@localhost:5432/auralis?schema=public"

# --- Cloudflare R2 (để trống thì API vẫn chạy, các endpoint storage trả 503) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=auralis-media
R2_PUBLIC_URL=https://cdn.example.com
R2_PRESIGN_EXPIRES_IN=600
# R2_ENDPOINT=http://localhost:4569   # chỉ dùng cho emulator S3 local

# --- Đăng nhập (JWT, tối thiểu 32 ký tự; bắt buộc ở production) ---
JWT_SECRET=
# URL công khai của API (dùng cho kho lưu trữ local khi chưa có R2)
API_PUBLIC_URL=http://localhost:4000
# STORAGE_LOCAL_FALLBACK=true
# LOCAL_MEDIA_DIR=media

# --- Hàng đợi tạo Radio AI (BullMQ + Redis) ---
REDIS_URL=redis://localhost:6379
AUDIO_AI_URL=http://localhost:8000
AUDIO_AI_API_KEY=
VOICESTUDIO_VOICE=auralis-studio
# DISABLE_QUEUE=true   # tắt hàng đợi (VD: chạy test không có Redis)
